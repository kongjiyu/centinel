# Model-provider credentials and endpoints are configured in the app's
# Settings > Model Provider section, not through environment variables.

# Supabase public runtime configuration. The VITE_* values are used by the
# desktop renderer for Supabase Auth; the non-VITE values are used by the
# sidecar. Leave these empty until you create your own Supabase project.
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Desktop authentication callback. Register this exact URL in Supabase
# Authentication > URL Configuration > Redirect URLs.
VITE_SUPABASE_AUTH_REDIRECT_URL=centinel://auth/callback

# Admin/migration tooling only. Never expose this through VITE_* or package it
# in the desktop app. The running sidecar must use the user's access token and
# Supabase RLS instead of this key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# OAuth callback base. Register the provider-specific callback paths below:
#   GitHub:      http://localhost:37701/integrations/github/callback
#   Google Drive:http://localhost:37701/integrations/google_drive/callback
#   Slack:       http://localhost:37701/integrations/slack/callback
OAUTH_CALLBACK_BASE_URL=http://localhost:37701

# GitHub repository OAuth. GitHub sign-in is configured separately in
# Supabase Authentication > Providers > GitHub.
GITHUB_REPO_CLIENT_ID=
GITHUB_REPO_CLIENT_SECRET=

# Google sign-in is configured in Supabase Authentication > Providers > Google.
# Google Drive OAuth is a separate sidecar integration and uses its own client.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Used to encrypt provider refresh/access tokens at rest. Generate a random
# value for your installation and keep it server-side only.
CENTINEL_TOKEN_ENCRYPTION_KEY=

# Optional absolute path to a locally installed Codex CLI. Leave empty when
# `codex` is on PATH. ChatGPT sign-in happens in Settings; no API key is used.
CENTINEL_CODEX_BIN=
