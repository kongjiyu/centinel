{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Centinel",
    "version": "0.2.1"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "dialog": {
        "all": false,
        "open": true,
        "save": true
      },
      "fs": {
        "all": true,
        "scope": [
          "**"
        ]
      },
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": false,
        "maximize": true,
        "unmaximize": true,
        "minimize": true,
        "close": true,
        "startDragging": true
      },
      "process": {
        "all": false,
        "relaunch": true
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [
        "binaries/centinel-node",
        "binaries/codex"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.centinel.app",
      "longDescription": "",
      "macOS": {
        "entitlements": "entitlements.plist",
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [
        "resources/sidecar/**/*",
        "resources/codex/**/*",
        "resources/sample-shop/**/*"
      ],
      "shortDescription": "",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/kongjiyu/centinel/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0MzgxNUI3QTk0QkUzNDEKUldSQjQwdXB0eFU0cERjeFJEeThZazJac1NUQzFkOFZiaG9qK3JPVFpMNTkvWFZRNyt1Y2hCWVoK"
    },
    "windows": [
      {
        "decorations": true,
        "fullscreen": false,
        "height": 800,
        "center": true,
        "hiddenTitle": false,
        "minHeight": 520,
        "minWidth": 620,
        "resizable": true,
        "theme": "Light",
        "title": "Centinel",
        "titleBarStyle": "Visible",
        "width": 1280
      }
    ]
  }
}
