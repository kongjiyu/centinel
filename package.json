{
  "name": "centinel-root",
  "private": true,
  "scripts": {
    "dev": "concurrently --names sidecar,app --prefix-colors blue,green \"pnpm --filter @centinel/sidecar start\" \"cd centinel && pnpm tauri dev\"",
